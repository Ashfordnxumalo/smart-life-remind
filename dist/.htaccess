# SmartRemind is a single-page app served from /smartreminder/.
#
# Routing is client-side, so Apache has to hand unknown paths back to
# index.html. Without this, loading or refreshing /smartreminder/auth makes
# Apache look for a directory of that name, fail to find one, and serve the
# parent site's 404 instead of the app.
#
# This file lives in public/ so Vite copies it into dist/ on every build —
# upload dist/ as-is and the rule comes with it.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /smartreminder/

  # Anything that exists on disk (bundles, logos, favicon) is served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is an in-app route: let React Router deal with it.
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html names the content-hashed bundles. A cached copy keeps pointing
  # at chunks that no longer exist after a deploy, so the app loads blank until
  # the browser gives up on its cache. Never cache it.
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Files under assets/ carry a content hash, so a rebuild produces a new URL
  # and the old one can be kept indefinitely.
  SetEnvIf Request_URI "/assets/" HASHED_ASSET=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

  # Retailer logos are deliberately NOT hashed — replacing one reuses the same
  # filename — so they get a short TTL and a new logo appears within the day.
  SetEnvIf Request_URI "/retailers/" RETAILER_LOGO=1
  Header set Cache-Control "public, max-age=86400" env=RETAILER_LOGO
</IfModule>

# Serve the correct type for fonts and source maps if the host's defaults miss them.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
